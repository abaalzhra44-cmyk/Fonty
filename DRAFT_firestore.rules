rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Default-Deny Catch-All
    match /{document=**} {
      allow read, write: if false;
    }

    // Global Primitives
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }
    function incoming() {
      return request.resource.data;
    }
    function existing() {
      return resource.data;
    }
    function isSignedIn() {
      return request.auth != null;
    }
    function isAdmin() {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        request.auth.token.email == 'abaalzhra44@gmail.com' ||
        request.auth.token.email == 'admin@fonty.dev'
      );
    }

    // Connection validation test endpoint
    match /test/{docId} {
      allow get: if true;
    }

    // Entity validation helpers
    function isValidUser(data) {
      return data.id is string && isValidId(data.id) &&
             data.username is string && data.username.size() > 0 && data.username.size() <= 100 &&
             data.email is string && data.email.size() <= 150;
    }

    function isValidProject(data) {
      return data.id is string && isValidId(data.id) &&
             data.name is string && data.name.size() > 0 && data.name.size() <= 150 &&
             data.ownerId is string && isValidId(data.ownerId);
    }

    function isValidSupportThread(data) {
      return data.id is string && isValidId(data.id) &&
             data.userName is string && data.userName.size() > 0 && data.userName.size() <= 100 &&
             (data.status in ['open', 'pending', 'resolved']);
    }

    function isValidSystemSetting(data) {
      return data.id is string && isValidId(data.id);
    }

    function isValidAuditLog(data) {
      return data.id is string && isValidId(data.id) &&
             data.type is string && data.type.size() > 0 && data.type.size() <= 100 &&
             data.msg is string && data.msg.size() > 0 && data.msg.size() <= 500;
    }

    // 1. Users collection
    match /users/{userId} {
      allow get: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow list: if isAdmin();
      allow create: if isSignedIn() && isValidId(userId) && request.auth.uid == userId &&
                       isValidUser(incoming()) && (isAdmin() || incoming().role == 'user');
      allow update: if isSignedIn() && isValidId(userId) && (
        isAdmin() ||
        (request.auth.uid == userId && isValidUser(incoming()) && incoming().role == existing().role)
      );
      allow delete: if isAdmin();
    }

    // 2. Admins collection
    match /admins/{adminId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // 3. Projects collection
    match /projects/{projectId} {
      allow get: if resource.data.isPublic == true || (isSignedIn() && (resource.data.ownerId == request.auth.uid || isAdmin()));
      allow list: if (resource.data.isPublic == true) || (isSignedIn() && resource.data.ownerId == request.auth.uid) || isAdmin();
      allow create: if isSignedIn() && isValidId(projectId) && isValidProject(incoming()) &&
                       (incoming().ownerId == request.auth.uid || isAdmin());
      allow update: if isSignedIn() && isValidId(projectId) && isValidProject(incoming()) && (
        isAdmin() ||
        (incoming().ownerId == existing().ownerId && existing().ownerId == request.auth.uid)
      );
      allow delete: if isSignedIn() && isValidId(projectId) && (isAdmin() || existing().ownerId == request.auth.uid);
    }

    // 4. Support Threads collection
    match /supportThreads/{threadId} {
      allow get: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && isValidId(threadId) && isValidSupportThread(incoming()) &&
                       (incoming().userId == request.auth.uid || isAdmin());
      allow update: if isSignedIn() && isValidId(threadId) && isValidSupportThread(incoming()) && (
        isAdmin() ||
        (existing().userId == request.auth.uid && incoming().userId == existing().userId)
      );
      allow delete: if isAdmin();
    }

    // 5. System Settings collection
    match /systemSettings/{settingId} {
      allow get: if true;
      allow list: if isSignedIn();
      allow write: if isAdmin() && isValidId(settingId) && isValidSystemSetting(incoming());
    }

    // 6. Audit Logs collection (Admin & Developer)
    match /auditLogs/{logId} {
      allow get, list: if isAdmin();
      allow create: if isSignedIn() && isValidId(logId) && isValidAuditLog(incoming());
      allow update, delete: if isAdmin();
    }
  }
}
